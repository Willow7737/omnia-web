DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Omnia Testnet Integration ──────────────────────────────────────────────
# Set LIVE_MODE=true to switch from static marketing site to live dashboard
# When true: enables API routes, SSR, react-query live data, WebSocket
# When false/empty: builds as static export for GitHub Pages
NEXT_PUBLIC_LIVE_MODE=false

# Base URL of the Omnia Protocol node (bootstrap or any peer)
# In Codespaces: https://<codespace-name>-9090.app.github.dev
# Locally with Docker: http://localhost:9090
NEXT_PUBLIC_OMNIA_API_URL=http://localhost:9090

# All node URLs for multi-node dashboard (comma-separated)
NEXT_PUBLIC_OMNIA_NODE_URLS=http://localhost:9090,http://localhost:9091,http://localhost:9092,http://localhost:9093,http://localhost:9094

# Polling interval in milliseconds for live data (default: 5000)
NEXT_PUBLIC_POLL_INTERVAL_MS=5000
